# PostgreSQL (Neon). Usá la URL "pooled" para DATABASE_URL.
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST/acopio?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generar con: openssl rand -base64 32"

# Usuario administrador que crea el seed (solo se usa al correr `npm run db:seed`)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# URL pública del sitio (sitemap, datos estructurados). En producción: https://tudominio
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Mercado Pago (Checkout Pro). Sin MP_ACCESS_TOKEN solo se ofrece transferencia. ---
MP_ACCESS_TOKEN=""
# Secreto del webhook (Tus integraciones → Webhooks). URL a configurar: https://tudominio/api/mp/webhook, evento "Pagos".
MP_WEBHOOK_SECRET=""

# --- Emails de confirmación (Resend). Sin estas variables no se envían emails. ---
RESEND_API_KEY=""
EMAIL_FROM="Acopio Saludable <pedidos@tudominio>"

# --- Envíos. Sin credenciales se usa la tabla por peso y zona del panel. ---
MICORREO_USER=""
MICORREO_PASSWORD=""
MICORREO_CUSTOMER_ID=""
# Pruebas: https://apitest.correoargentino.com.ar/micorreo/v1
MICORREO_API_URL=""
ANDREANI_USER=""
ANDREANI_PASSWORD=""
ANDREANI_CLIENTE=""
ANDREANI_CONTRATO_DOMICILIO=""
ANDREANI_CONTRATO_SUCURSAL=""
# Pruebas: https://apisqa.andreani.com
ANDREANI_API_URL=""
BLOB_READ_WRITE_TOKEN=""  # Lo carga solo Vercel al conectar un almacén Blob (Storage → Blob). Necesario para subir imágenes propias.
