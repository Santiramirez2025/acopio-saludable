# PostgreSQL (Neon). Usá la URL "pooled" para DATABASE_URL.
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST/acopio?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generar con: openssl rand -base64 32"

# Usuario administrador que crea el seed (solo se usa al correr `npm run db:seed`)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# URL pública del sitio (sitemap, datos estructurados). En producción: https://tudominio
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
