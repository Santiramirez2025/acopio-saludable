generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstadoProducto {
  ACTIVO
  BORRADOR
  SIN_STOCK
}

enum EstadoPedido {
  PENDIENTE_PAGO
  PAGADO
  EN_COMPRA
  PREPARADO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum MedioPago {
  MERCADOPAGO
  TRANSFERENCIA
}

enum TipoCombo {
  COMBO
  PEDIDO_NICHO
}

model Product {
  // El código es TEXTO: puede empezar con 0. Nunca se convierte a número.
  codigo        String   @id
  producto      String
  marca         String
  presentacion  String
  categoria     String
  formato       String
  costo         Decimal  @db.Decimal(12, 2)
  precioPublico Decimal  @db.Decimal(12, 2)
  // (precio - costo) / precio * 100. Se recalcula en cada escritura de precio o costo.
  margenPct     Decimal  @db.Decimal(6, 2)
  contenido     Int?
  unidad        String? // "g" | "ml"
  pesoBrutoG    Int?
  pesoEstimado  Boolean  @default(true)

  fotoUrl String?
  fotos   String[] @default([])

  nichos                String[] @default([])
  objetivos             String[] @default([])
  clasificacionRevisada Boolean  @default(false)

  estado           EstadoProducto @default(ACTIVO)
  visible          Boolean        @default(true)
  ocultoMotivo     String?
  gancho           Boolean        @default(false)
  porQueLoElegimos String?
  vendidos         Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  historial  PriceHistory[]
  comboItems ComboItem[]

  @@index([categoria])
  @@index([marca])
  @@index([visible, estado, margenPct])
}

model PriceHistory {
  id            Int      @id @default(autoincrement())
  codigo        String
  product       Product  @relation(fields: [codigo], references: [codigo], onDelete: Cascade)
  costo         Decimal  @db.Decimal(12, 2)
  precioPublico Decimal  @db.Decimal(12, 2)
  origen        String // "seed" | "csv" | "manual" | "sync"
  fecha         DateTime @default(now())

  @@index([codigo, fecha])
}

model Combo {
  id           Int       @id @default(autoincrement())
  slug         String    @unique
  nombre       String
  tipo         TipoCombo @default(COMBO)
  nicho        String?
  descuentoPct Decimal   @default(0) @db.Decimal(5, 2)
  activo       Boolean   @default(true)
  destacado    Boolean   @default(false)
  vigenteDesde DateTime?
  vigenteHasta DateTime?
  items        ComboItem[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ComboItem {
  comboId  Int
  codigo   String
  cantidad Int     @default(1)
  combo    Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  product  Product @relation(fields: [codigo], references: [codigo])

  @@id([comboId, codigo])
}

// Fila única (id = 1) con la configuración del negocio.
model Setting {
  id                       Int      @id @default(1)
  compraMinima             Decimal  @default(60000) @db.Decimal(12, 2)
  margenMinimoPct          Decimal  @default(12) @db.Decimal(5, 2)
  descuentoTransferenciaPct Decimal @default(0) @db.Decimal(5, 2)
  // Recargo para calcular el precio sugerido de reventa que ve el cliente. 0 = no se muestra.
  recargoSugeridoPct       Decimal  @default(40) @db.Decimal(5, 2)
  // Corte de compra al proveedor: días (0 = domingo … 6 = sábado, separados por coma; vacío = no se muestra) y hora.
  corteDias                String   @default("1,2,3,4,5")
  corteHora                Int      @default(14)
  comisionPagoPct          Decimal  @default(0) @db.Decimal(5, 2)
  costoPackaging           Decimal  @default(0) @db.Decimal(12, 2)
  envioGratisDesde         Decimal? @db.Decimal(12, 2)

  // Contacto y cobro (datos reales que carga el dueño; nada inventado)
  whatsapp           String?
  emailContacto      String?
  transferenciaDatos String?

  // Envíos
  cpOrigen             String  @default("5152")
  entregaPropiaActiva  Boolean @default(true)
  // Códigos postales con entrega propia sin cargo: lista y rangos, ej. "5152,5000-5022"
  cpEntregaPropia      String  @default("5152,5000-5022")
  // Tabla de respaldo por peso y zona (JSON). Null = valores de ejemplo del código.
  tablaEnvios          Json?
  tablaEnviosRevisada  Boolean @default(false)

  // Sincronización de precios
  // Hash del token que usa el marcador de sincronización (el token en claro se muestra una sola vez).
  syncTokenHash String?
  // Cambios menores a este porcentaje se aplican solos; el resto espera aprobación.
  umbralAutoPct Decimal @default(10) @db.Decimal(5, 2)
  updatedAt                DateTime @updatedAt
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Order {
  id        Int          @id @default(autoincrement())
  // Identificador público impredecible para la página de seguimiento del cliente.
  token     String       @unique
  estado    EstadoPedido @default(PENDIENTE_PAGO)
  medioPago MedioPago

  nombre    String
  email     String
  telefono  String
  calle     String
  ciudad    String
  provincia String
  cp        String
  notas     String?

  subtotal      Decimal @db.Decimal(12, 2)
  descuento     Decimal @default(0) @db.Decimal(12, 2)
  envioCobrado  Decimal @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)

  // Costos reales, para el margen neto exacto por pedido.
  costoProductos Decimal @db.Decimal(12, 2)
  costoEnvioReal Decimal @db.Decimal(12, 2)
  comisionPago   Decimal @default(0) @db.Decimal(12, 2)
  costoPackaging Decimal @default(0) @db.Decimal(12, 2)

  envioOpcionId String
  envioNombre   String
  envioPlazo    String?
  envioOrigen   String // "propia" | "tabla" | "micorreo" | "andreani"
  pesoTotalG    Int
  bultos        Int
  tracking      String?

  mpPreferenceId String?
  mpPaymentId    String?
  pagadoAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   OrderItem[]
  eventos OrderEvent[]

  @@index([estado, createdAt])
}

// Foto del producto al momento de la compra: precio y costo no cambian aunque después cambie el catálogo.
model OrderItem {
  id             Int     @id @default(autoincrement())
  orderId        Int
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  codigo         String
  producto       String
  presentacion   String
  cantidad       Int
  precioUnitario Decimal @db.Decimal(12, 2)
  costoUnitario  Decimal @db.Decimal(12, 2)
  comboSlug      String?

  @@index([orderId])
}

model OrderEvent {
  id      Int          @id @default(autoincrement())
  orderId Int
  order   Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  estado  EstadoPedido
  nota    String?
  fecha   DateTime     @default(now())

  @@index([orderId, fecha])
}

enum EstadoCambio {
  APLICADO
  PENDIENTE
  RECHAZADO
}

// Una corrida de actualización de precios (marcador, JSON o CSV) y su diff.
model PriceSync {
  id        Int      @id @default(autoincrement())
  origen    String // "marcador" | "json" | "csv"
  modo      String // "costos" (costo + precio público) | "publicos" (solo precio público)
  completo  Boolean  @default(false)
  recibidos Int
  nota      String?
  createdAt DateTime @default(now())
  items     PriceSyncItem[]

  @@index([createdAt])
}

model PriceSyncItem {
  id          Int          @id @default(autoincrement())
  syncId      Int
  sync        PriceSync    @relation(fields: [syncId], references: [id], onDelete: Cascade)
  codigo      String
  producto    String
  tipo        String // "CAMBIO" | "NUEVO" | "DESAPARECIDO" | "REAPARECIDO"
  costoAntes  Decimal?     @db.Decimal(12, 2)
  costoNuevo  Decimal?     @db.Decimal(12, 2)
  precioAntes Decimal?     @db.Decimal(12, 2)
  precioNuevo Decimal?     @db.Decimal(12, 2)
  // Mayor variación (en valor absoluto) entre costo y precio, con su signo.
  pct         Decimal?     @db.Decimal(9, 2)
  estado      EstadoCambio
  resueltoAt  DateTime?

  @@index([syncId, estado])
}
